# Скопируйте этот файл в .env и заполните. Файл .env НЕ попадает в git.

# Ключ из Google AI Studio (aistudio.google.com → Get API key).
# Если оставить пустым, мастер будет работать в режиме заглушки — удобно для проверки сайта.
GEMINI_API_KEY=

# Модель по умолчанию (в каждой комнате можно поменять в настройках).
GEMINI_MODEL=gemini-2.5-flash

# Бюджет «размышлений» модели в токенах. Пусто = как решит модель, 0 = выключить (быстрее).
GEMINI_THINKING_BUDGET=

# Пароль для создания комнат, чтобы посторонние не тратили ваши лимиты. Пусто = без пароля.
CREATE_ROOM_PASSWORD=

# Порт на сервере, на котором будет открыт сайт.
PORT=8000
